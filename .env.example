# ---------------------------------------------------------------
# BarberApp - root environment for Docker Compose.
# Copy to .env and change JWT_SECRET_KEY before running anything
# that is not a local development container.
# ---------------------------------------------------------------

APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
POSTGRES_DB=barberapp
POSTGRES_USER=barberuser
POSTGRES_PASSWORD=barberpass
POSTGRES_PORT=5432

# Authentication. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-random-48-byte-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shop configuration
SHOP_TIMEZONE=America/Argentina/Buenos_Aires
CURRENCY=ARS
BOOKING_SLOT_MINUTES=15
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_MAX_ADVANCE_DAYS=60
BOOKING_CANCELLATION_CUTOFF_MINUTES=120

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Portfolio demo sandbox
DEMO_ENABLED=true
DEMO_SESSION_TTL_MINUTES=45
DEMO_IDLE_TIMEOUT_MINUTES=15
DEMO_MAX_APPOINTMENTS=12
DEMO_MAX_WRITES=80
DEMO_MAX_ACTIVE_SESSIONS=40
DEMO_RATE_LIMIT_PER_HOUR=6
