# Production environment for BarberApp. Copy to .env.prod on the server
# and fill in the secrets. Never commit .env.prod.

APP_ENV=production
DEBUG=false
SQL_ECHO=false
LOG_LEVEL=INFO

# The database runs as a container in the neighbouring stack; the host
# name is the container name on the shared Docker network.
DATABASE_URL=postgresql+asyncpg://barberapp:REPLACE_ME@data-center-db-1:5432/barberapp

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_ME
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# The frontend is served same-origin through the Cloudflare Worker, so the
# browser never makes a cross-origin call. The allowlist stays explicit
# anyway: production refuses to start with a wildcard.
CORS_ORIGINS=https://barberapp.aaronbrumat.com.ar

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

SHOP_TIMEZONE=America/Argentina/Buenos_Aires
CURRENCY=ARS
BOOKING_SLOT_MINUTES=15
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_MAX_ADVANCE_DAYS=60
BOOKING_CANCELLATION_CUTOFF_MINUTES=120

DEMO_ENABLED=true
DEMO_SESSION_TTL_MINUTES=45
DEMO_IDLE_TIMEOUT_MINUTES=15
DEMO_MAX_APPOINTMENTS=12
DEMO_MAX_WRITES=80
DEMO_MAX_ACTIVE_SESSIONS=25
DEMO_RATE_LIMIT_PER_HOUR=6
