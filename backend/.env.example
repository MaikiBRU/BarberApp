# Backend-only environment for running uvicorn outside Docker.

APP_NAME=BarberApp
APP_ENV=development
DEBUG=true
SQL_ECHO=false
LOG_LEVEL=INFO

# PostgreSQL. For a quick SQLite run use:
#   DATABASE_URL=sqlite+aiosqlite:///./dev.sqlite3
DATABASE_URL=postgresql+asyncpg://barberuser:barberpass@localhost:5432/barberapp

# Development-only secret. Never reuse it outside local development.
JWT_SECRET_KEY=dev-secret-key-change-me-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

SHOP_TIMEZONE=America/Argentina/Buenos_Aires
CURRENCY=ARS
BOOKING_SLOT_MINUTES=15
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_MAX_ADVANCE_DAYS=60
BOOKING_CANCELLATION_CUTOFF_MINUTES=120

# Portfolio demo sandbox
DEMO_ENABLED=true
DEMO_SESSION_TTL_MINUTES=45
DEMO_IDLE_TIMEOUT_MINUTES=15
DEMO_MAX_APPOINTMENTS=12
DEMO_MAX_WRITES=80
DEMO_MAX_ACTIVE_SESSIONS=40
DEMO_RATE_LIMIT_PER_HOUR=6
